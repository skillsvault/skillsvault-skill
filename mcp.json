{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "skillsvault": {
      "type": "streamable-http",
      "url": "https://skillsvault.io/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": [
              "mcp"
            ]
          }
        }
      }
    }
  }
}
